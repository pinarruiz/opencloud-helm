#!/bin/sh
set -e

# Create apps directory if it doesn't exist
mkdir -p /var/lib/opencloud/web/assets/apps

# Copy extensions to the apps directory
{{- range $name, $ext := .Values.webExtensions.extensions }}
{{- if $ext.enabled }}
{{- $folder := default $name $ext.folder }}
echo "Initializing {{ $folder }} extension..."
cp -R /extensions/{{ $folder }}/ /var/lib/opencloud/web/assets/apps/
{{- end }}
{{- end }}

echo "Web extensions initialization completed."
